# 실제 값은 이 파일에 적지 마세요.
# 이 파일을 복사해 .env 파일을 만든 뒤, .env에만 실제 값을 입력합니다.
# .env는 .gitignore에 등록되어 Git에 올라가지 않습니다.

# OpenAI API Key (STEP 12부터 사용)
OPENAI_API_KEY=

# 호출할 OpenAI 모델명 (예: .env에만 실제 모델명을 입력)
OPENAI_MODEL=

# Google Gemini API Key
GEMINI_API_KEY=

# 호출할 Gemini 모델명
GEMINI_MODEL=

# Slack Incoming Webhook URL (STEP 15부터 사용)
SLACK_WEBHOOK_URL=

# Gmail 발신 계정 주소 (STEP 16부터 사용)
GMAIL_ADDRESS=

# Google 앱 비밀번호 (일반 로그인 비밀번호 아님)
GMAIL_APP_PASSWORD=

# 보고서를 받을 수신 이메일 주소
GMAIL_TO=
